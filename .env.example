# =============================================================================
# quant-trader -- example environment file
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`.
#
#   cp .env.example .env        (macOS / Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Every variable below has a safe default. The system runs fully offline/local
# with an empty .env -- no paid service is required.
# =============================================================================

# -----------------------------------------------------------------------------
# TRADING MODE -- SAFETY CRITICAL
# -----------------------------------------------------------------------------
# PAPER_TRADING=true  -> simulated fills only, no broker orders leave the machine
# LIVE_TRADING=false  -> hard-blocks any real order path
#
# Live trading is NOT implemented. Setting LIVE_TRADING=true currently only
# raises an explicit error; it does not enable real orders.
PAPER_TRADING=true
LIVE_TRADING=false

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# SQLite by default (free, local, zero setup). The schema is written against
# SQLAlchemy so a PostgreSQL URL can be dropped in later without code changes:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/quant_trader
DATABASE_URL=sqlite:///data/quant_trader.db

# -----------------------------------------------------------------------------
# DATA PROVIDERS
# -----------------------------------------------------------------------------
# Default provider for historical research. "yfinance" is free and needs no key.
DEFAULT_PROVIDER_USA=yfinance
DEFAULT_PROVIDER_CHILE=yfinance

# Polite pause between provider requests, in seconds. Raise it if you hit
# rate limiting on large universes.
PROVIDER_REQUEST_DELAY=0.4
PROVIDER_MAX_RETRIES=3
PROVIDER_TIMEOUT=30

# -----------------------------------------------------------------------------
# ALPACA -- optional, free paper-trading tier, US equities only
# -----------------------------------------------------------------------------
# Leave blank to keep the internal paper broker. Alpaca does NOT support
# Chilean equities; Chile always routes to the internal paper broker.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# TELEGRAM -- optional, free
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false
TELEGRAM_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# TRANSACTION COSTS -- per market, independent, all configurable
# -----------------------------------------------------------------------------
# These are NOT researched broker rates. They are placeholders you must replace
# with your actual broker's figures. Assuming zero cost silently inflates every
# backtest, so the system refuses to default them to 0.
#
# commission_bps : commission in basis points of notional (10 bps = 0.10%)
# min_commission : currency-denominated floor per order
# slippage_bps   : assumed adverse fill vs decision price
# spread_bps     : assumed half-spread paid on entry and exit
USA_COMMISSION_BPS=1.0
USA_MIN_COMMISSION=0.0
USA_SLIPPAGE_BPS=2.0
USA_SPREAD_BPS=1.0

# Chilean equities are materially more expensive to trade than US large caps
# (lower liquidity, wider spreads, brokerage minimums). Placeholders are set
# higher on purpose -- replace with your broker's real schedule.
CHILE_COMMISSION_BPS=25.0
CHILE_MIN_COMMISSION=0.0
CHILE_SLIPPAGE_BPS=15.0
CHILE_SPREAD_BPS=10.0

# -----------------------------------------------------------------------------
# RISK LIMITS -- used by the risk engine and kill switch
# -----------------------------------------------------------------------------
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SIZE_PCT=10.0
MAX_DAILY_LOSS_PCT=3.0
MAX_PORTFOLIO_DRAWDOWN_PCT=20.0
MAX_SIMULTANEOUS_POSITIONS=10
MAX_MARKET_EXPOSURE_PCT=100.0
MAX_SECTOR_EXPOSURE_PCT=35.0

# Data older than this many calendar days is treated as stale and blocks
# new position entries (kill-switch: stale data protection).
STALE_DATA_MAX_AGE_DAYS=5

# -----------------------------------------------------------------------------
# BACKTEST DEFAULTS
# -----------------------------------------------------------------------------
INITIAL_CAPITAL_USD=100000
INITIAL_CAPITAL_CLP=50000000

# -----------------------------------------------------------------------------
# TRAIN / VALIDATION / TEST SPLIT -- leakage guard
# -----------------------------------------------------------------------------
# The optimizer is only ever allowed to read TRAIN. VALIDATION selects among
# candidates. TEST stays sealed until a run is explicitly finalised.
SPLIT_TRAIN_START=2016-01-01
SPLIT_TRAIN_END=2021-12-31
SPLIT_VALIDATION_START=2022-01-01
SPLIT_VALIDATION_END=2023-12-31
SPLIT_TEST_START=2024-01-01
SPLIT_TEST_END=2026-12-31

# -----------------------------------------------------------------------------
# API / LOGGING
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
LOG_FILE=logs/quant_trader.log
